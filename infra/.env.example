# =============================================================================
# RAG API New - Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in the values

# =============================================================================
# LLM Provider Credentials
# =============================================================================

# === GigaChat (Sber) ===
# Base64-encoded credentials for GigaChat API
# Format: base64(client_id:client_secret)
GIGA_AUTH_DATA=

# === DeepSeek ===
# API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# === Qwen via LiteLLM (local vLLM) ===
LITELLM_BASE_URL=http://localhost:8005/v1
LITELLM_API_KEY=sk-local-any

# =============================================================================
# LLM Roles (format: "provider:model")
# =============================================================================
# Supported providers: gigachat, deepseek, qwen
#
# Examples:
#   gigachat:GigaChat-2
#   deepseek:deepseek-chat
#   deepseek:deepseek-reasoner
#   qwen:Qwen2.5

# Identity - answers "who are you?", "what can you do?"
# Use cheap model, task is simple
IDENTITY_LLM=deepseek:deepseek-chat

# Planner - generates QueryPlanV3 with structured output
# DeepSeek R1 excels at reasoning
PLANNER_LLM=deepseek:deepseek-reasoner

# Answer - generates user-facing response
# GigaChat excels at Russian language
ANSWER_LLM=gigachat:GigaChat-2

# Critic - evaluates fact sufficiency
# Good reasoning needed
CRITIC_LLM=deepseek:deepseek-reasoner

# Agent - ReAct orchestration, tool calling
# Reliable model needed
AGENT_LLM=gigachat:GigaChat-2

# =============================================================================
# LLM Temperatures
# =============================================================================

# Identity - slightly higher for natural responses
IDENTITY_TEMPERATURE=0.3

# Planner - deterministic for consistent plans
PLANNER_TEMPERATURE=0.0

# Answer - balance between accuracy and naturalness
ANSWER_TEMPERATURE=0.2

# Critic - moderate for evaluation
CRITIC_TEMPERATURE=0.2

# Agent - moderate for orchestration
AGENT_TEMPERATURE=0.2

# =============================================================================
# ChromaDB (Vector Database)
# =============================================================================
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=portfolio_new

# =============================================================================
# Redis (Caching & Rate Limiting)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
PLAN_CACHE_TTL=3600
EMBEDDING_CACHE_TTL=86400

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_MAX_TOKENS=50000

# =============================================================================
# Reranker
# =============================================================================
RERANKER_MODEL=BAAI/bge-reranker-base

# =============================================================================
# CORS / Frontend
# =============================================================================
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_LOCAL_IP=http://192.168.1.36:3000

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Embedding Model (via LiteLLM)
# =============================================================================
EMBEDDING_MODEL=embedding-default

# =============================================================================
# Critic Settings (Lazy Critic optimization)
# =============================================================================
CRITIC_ENABLED=true
CRITIC_CONFIDENCE_THRESHOLD=0.8
CRITIC_MIN_FACTS_THRESHOLD=3
# Comma-separated list of intents to skip critic
CRITIC_SKIP_INTENTS=CONTACTS,CURRENT_JOB
