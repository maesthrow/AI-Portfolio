# =============================================================================
# AI-Portfolio - Environment Configuration Example
# =============================================================================
# Copy this file to .env.local (dev) or .env.prod (production) and fill in values

DOMAIN=ai-folio.ru

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_DB=ai_portfolio_new
POSTGRES_USER=ai_portfolio_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# =============================================================================
# CORS / Frontend
# =============================================================================
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_LOCAL_IP=http://192.168.1.36:3000

# Frontend client-side env vars (NEXT_PUBLIC_* are inlined at build time)
NEXT_PUBLIC_CONTENT_API_BASE=http://localhost:8003/api/v1
NEXT_PUBLIC_AGENT_API_BASE=http://localhost:8014
NEXT_PUBLIC_CHARS_PER_SECOND=60
NEXT_PUBLIC_MAX_CHARS_PER_TICK=4

# =============================================================================
# Ports (host-side)
# =============================================================================
RAG_PORT=8004
RAG_NEW_PORT=8014
LITELLM_PORT=8005
TEI_PORT=8006

# =============================================================================
# LiteLLM (unified proxy for LLM / Embeddings)
# =============================================================================
LITELLM_MASTER_KEY=CHANGE_ME
LITELLM_API_KEY=CHANGE_ME
LITELLM_BASE_URL=http://litellm:4000/v1

# Model aliases (must match infra/litellm/config.yaml)
CHAT_MODEL=GigaChat
# tei (local TEI) or gigachat (cloud GigaChat API)
EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=embedding-default

# =============================================================================
# LLM Provider Credentials
# =============================================================================

# === GigaChat (Sber) ===
# Base64-encoded credentials: base64(client_id:client_secret)
GIGA_AUTH_DATA=

# === DeepSeek ===
# API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# =============================================================================
# LLM Roles (format: "provider:model")
# =============================================================================
# Supported providers: gigachat, deepseek, qwen
#
# Examples:
#   gigachat:GigaChat-2
#   deepseek:deepseek-chat
#   deepseek:deepseek-reasoner
#   qwen:Qwen2.5

# Identity - answers "who are you?", "what can you do?"
IDENTITY_LLM=deepseek:deepseek-chat

# Planner - generates QueryPlanV3 with structured output
PLANNER_LLM=gigachat:GigaChat-2

# Answer - generates user-facing response
ANSWER_LLM=deepseek:deepseek-chat

# Critic - evaluates fact sufficiency
CRITIC_LLM=deepseek:deepseek-reasoner

# Agent - ReAct orchestration, tool calling
# WARNING: deepseek-reasoner CANNOT be used here (no tool calling support)
AGENT_LLM=gigachat:GigaChat-2

# Router - intent classification (regex fallback, cheap model)
# Used only when regex fast-path doesn't match (~30% of messages)
ROUTER_LLM=deepseek:deepseek-chat

# =============================================================================
# LLM Temperatures
# =============================================================================
IDENTITY_TEMPERATURE=0.3
PLANNER_TEMPERATURE=0.0
ANSWER_TEMPERATURE=0.2
CRITIC_TEMPERATURE=0.2
AGENT_TEMPERATURE=0.2
ROUTER_TEMPERATURE=0.0

# =============================================================================
# TEI (Text Embeddings Inference)
# =============================================================================
TEI_BASE_URL=http://tei:80/v1

# =============================================================================
# Embedding & Reranker
# =============================================================================
EMBEDDING_BATCH_SIZE=4
RERANKER_MODEL=BAAI/bge-reranker-base
MAX_RERANK_CANDIDATES=80

# =============================================================================
# pgvector (Vector Database — shared PostgreSQL)
# =============================================================================
COLLECTION_NAME=portfolio_new

# =============================================================================
# Critic Settings (Lazy Critic optimization)
# =============================================================================
CRITIC_ENABLED=true
CRITIC_CONFIDENCE_THRESHOLD=0.7
CRITIC_MIN_FACTS_THRESHOLD=2
CRITIC_SKIP_INTENTS=["contacts", "current_job"]

# =============================================================================
# Redis / Cache
# =============================================================================
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
PLAN_CACHE_TTL=0
EMBEDDING_CACHE_TTL=0

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_TOKENS=50000
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_WARNING_THRESHOLD=0.8
RATE_LIMIT_LOG_IP_MODE=masked

# =============================================================================
# User Input Validation
# =============================================================================
# Approximate token limit (~4 chars per token)
MAX_USER_INPUT_TOKENS=250

# Frontend token counter - должен быть синхронизирован с MAX_USER_INPUT_TOKENS
NEXT_PUBLIC_MAX_INPUT_TOKENS=250
NEXT_PUBLIC_CHARS_PER_TOKEN=4

# =============================================================================
# SMTP Email (CV sending)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI-Portfolio | Дмитрий Каргин
SMTP_USE_TLS=true

# =============================================================================
# CV File & Rate Limits
# =============================================================================
CV_FILE_PATH=/app/data/cv.pdf
# Filename shown in the email attachment (falls back to cv_file_path basename)
CV_ATTACHMENT_NAME=CV Dmitriy Kargin - AI Engineer.pdf
CV_SEND_LIMIT_PER_IP=3
CV_SEND_LIMIT_PER_EMAIL=2
CV_SEND_LIMIT_WINDOW_SECONDS=3600

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
